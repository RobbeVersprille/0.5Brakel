{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare build directory",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path '${workspaceFolder}\\build' | Out-Null"
      ],
      "problemMatcher": []
    },
    {
      "label": "Assemble NES source",
      "type": "process",
      "command": "ca65",
      "args": [
        "src/game.asm",
        "-o",
        "build/game.o"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Prepare build directory",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Link NES ROM",
      "type": "process",
      "command": "ld65",
      "args": [
        "-C",
        "nes.cfg",
        "-m",
        "build/game.map",
        "build/game.o",
        "-o",
        "build/game.nes"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Assemble NES source",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build NES ROM",
      "dependsOn": "Link NES ROM",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
